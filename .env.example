# Copy this file to .env and adjust if needed.
DATABASE_URL=postgres://outhouse:outhouse@localhost:5432/outhouse
BIND_ADDR=0.0.0.0:8080
WEB_DIR=web
RUST_LOG=outhouse_server=debug,tower_http=info

# Where uploaded files are stored.
UPLOAD_DIR=data/uploads

# Voice (LiveKit). These match `livekit-server --dev` in docker-compose.yml.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Address browsers use for LiveKit. Leave blank to use the same host as the
# page on port 7880 (works for localhost and your home network).
LIVEKIT_URL=
# For voice on other devices at home, set this to your PC's LAN IP and
# restart LiveKit: docker compose up -d livekit
LIVEKIT_NODE_IP=127.0.0.1

# GIF picker: get a free key at https://developers.giphy.com/dashboard/
# (create an "API" app). Leave blank to switch the GIF button off.
GIPHY_API_KEY=
